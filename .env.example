# ---------------------------------------------------------------------------
# Tax Assistant Server — environment configuration template
# Copy to .env (git-ignored) and fill in credentials. The server reads
# these via std::getenv at startup.
# ---------------------------------------------------------------------------

# --- Network server settings ---
PORT=8080
HOST=0.0.0.0

# --- AI integration (Step G live mode; not needed for mock mode) ---
# Set AI_MODE to "live" to activate the real GroqClient extractor
# (requires GROQ_API_KEY). Leave as "mock" (or unset) for the offline
# MockExtractor.
AI_MODE=mock
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-11b-vision-preview

# --- File paths (all relative to project root, absolute also accepted) ---
DATABASE_PATH=./database/tax_sessions.db
RULES_CONFIG_PATH=./config/rules_2026.json
GROQ_SCHEMA_PATH=./config/groq_schema.json