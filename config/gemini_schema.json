{
  "$schema_description": "Strict JSON contract for invoice extraction. Gemini Pro (Phase 2, live mode) and the offline MockExtractor (Phase 1) MUST return a document conforming to this tree. Field paths here are referenced by config/rules_2026.json and validated natively by StateMatrix using nlohmann/json type-checking (no external json-schema-validator dependency).",

  "meta": {
    "format_version": "1.0",
    "currency": "INR",
    "date_format": "YYYY-MM-DD",
    "amount_scale": 2
  },

  "supplier": {
    "$type": "object",
    "$required": true,
    "gstin":       { "$type": "string",  "$required": true,  "description": "15-char supplier GSTIN, format 22BBBBB0000C1Z5." },
    "name":        { "$type": "string",  "$required": true,  "description": "Legal supplier name as printed." },
    "address_state": { "$type": "string", "$required": true, "description": "Two-letter GST state code (e.g. MH, KA) of the supplier's principal place of business." },
    "aato_crore":  { "$type": "number",  "$required": false, "description": "Aggregate Annual Turnover of the supplier in INR Crore from the prior completed FY. Absent if unknown; drives e-invoicing checks (R-EINV-001)." }
  },

  "buyer": {
    "$type": "object",
    "$required": false,
    "description": "Absent/empty when the buyer is unregistered (B2C) or cannot be determined.",
    "gstin":         { "$type": "string", "$required": false, "description": "15-char buyer GSTIN. Presence distinguishes B2B from B2C (R-CLASS-007)." },
    "name":          { "$type": "string", "$required": false, "description": "Legal buyer name as printed." },
    "address_state": { "$type": "string", "$required": false, "description": "Two-letter GST state code of the buyer's place of business." },
    "registered":    { "$type": "boolean", "$required": false, "description": "true if buyer holds a valid GSTIN, else false." }
  },

  "invoice": {
    "$type": "object",
    "$required": true,
    "number":            { "$type": "string",  "$required": true,  "description": "Invoice number exactly as printed." },
    "date":              { "$type": "string",  "$required": true,  "description": "Invoice date YYYY-MM-DD." },
    "place_of_supply":   { "$type": "string",  "$required": true,  "description": "One of 'same_as_supplier_state' (intra) or a two-letter GST state code (inter)." },
    "supply_type":       { "$type": "string",  "$required": true,  "description": "'INTRA' or 'INTER' derived from place_of_supply." },
    "classification":    { "$type": "string",  "$required": true,  "description": "'B2B', 'B2C', or 'UNDETERMINED' (triggers R-CLASS-007 gap interrogation)." },
    "irn_present":       { "$type": "boolean", "$required": true,  "description": "true if a 64-char IRN string is visible on the invoice." },
    "irn":               { "$type": "string",  "$required": false, "description": "The 64-character IRN when irn_present." },
    "hsn_string":        { "$type": "string",  "$required": true,  "description": "Comma-delimited HSN codes found (R-HSN-005 digit check)." },
    "base_value":        { "$type": "number",  "$required": true,  "description": "Total taxable base value in INR before tax (sum of line item base values)." },

    "line_items": {
      "$type": "array",
      "$required": true,
      "$item": {
        "hsn":         { "$type": "string",  "$required": true, "description": "Goods/service HSN or SAC code." },
        "description": { "$type": "string",  "$required": false, "description": "Item description text." },
        "quantity":    { "$type": "number",  "$required": false },
        "unit_price":  { "$type": "number",  "$required": false, "description": "Per-unit price without tax." },
        "base_value":  { "$type": "number",  "$required": true,  "description": "Line taxable value in INR." },
        "tax_rate":    { "$type": "number",  "$required": true,  "description": "Combined GST rate percent (e.g. 18)." }
      }
    },

    "tax_breakdown": {
      "$type": "object",
      "$required": true,
      "cgst":            { "$type": "number",  "$required": false, "description": "Central GST amount in INR." },
      "sgst":            { "$type": "number",  "$required": false, "description": "State/UT GST amount in INR." },
      "igst":            { "$type": "number",  "$required": false, "description": "Integrated GST amount in INR." },
      "cess":            { "$type": "number",  "$required": false, "description": "GST compensation cess, if any." },
      "has_cgst_sgst":   { "$type": "boolean", "$required": true,  "description": "Computed: any CGST or SGST present." },
      "has_igst":        { "$type": "boolean", "$required": true,  "description": "Computed: any IGST present." },
      "total_tax":       { "$type": "number",  "$required": true,  "description": "Sum of all tax heads in INR." }
    },

    "total_value": { "$type": "number", "$required": true, "description": "Grand total = base_value + total_tax in INR." }
  },

  "irp": {
    "$type": "object",
    "$required": false,
    "description": "IRP filing metadata for e-invoiced transactions (R-IRP-002).",
    "reported_on":          { "$type": "string", "$required": false, "description": "IRP acknowledgment date YYYY-MM-DD." },
    "acknowledgment_no":    { "$type": "string", "$required": false, "description": "IRP acknowledgement number when available." }
  },

  "extraction_confidence": {
    "$type": "object",
    "$required": false,
    "overall_score":  { "$type": "number", "$required": false, "description": "0..1 extraction confidence." },
    "warnings":       { "$type": "array",  "$required": false, "$item": { "$type": "string" }, "description": "Human-readable extraction warnings." }
  }
}